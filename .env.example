# Any OpenAI-compatible chat endpoint works. Never commit the real .env file.
# Default: Zhipu GLM-4-Flash (free). Get a key at https://open.bigmodel.cn
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash

# Other options (uncomment one block instead):
# SiliconFlow free tier, https://cloud.siliconflow.cn
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Local model with Ollama (no key needed; any non-empty LLM_API_KEY works)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# Only needed for the Discord front end
DISCORD_TOKEN=your-discord-bot-token
